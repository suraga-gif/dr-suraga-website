<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ title }} | Dr. Suraga Belakawadi</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'Lora',serif;background:#FAFAFA;color:#1A1A1A;line-height:1.7;}
  h1,h2,h3{font-family:'Poppins',sans-serif;}
  a{color:#185FA5;}
  nav{display:flex;justify-content:space-between;align-items:center;padding:1.2rem 6%;border-bottom:1px solid #e2e0d6;}
  nav a{margin-left:1.5rem;text-decoration:none;color:#1A1A1A;font-family:'Poppins',sans-serif;font-size:.9rem;}
  .wrap{max-width:800px;margin:0 auto;padding:3rem 6%;}
  .post-card{border-bottom:1px solid #e2e0d6;padding:2rem 0;}
  .post-card h2{font-size:1.5rem;margin-bottom:.4rem;}
  .post-card .date{font-size:.8rem;color:#63707e;margin-bottom:.6rem;}
  .post-card img{width:100%;max-height:300px;object-fit:cover;margin:1rem 0;border-radius:4px;}
  .btn{display:inline-block;background:#185FA5;color:#fff;padding:.7rem 1.4rem;border-radius:100px;text-decoration:none;font-family:'Poppins',sans-serif;font-size:.85rem;margin-top:2rem;}
  footer{text-align:center;padding:2rem;color:#63707e;font-size:.8rem;}
</style>
</head>
<body>
<nav>
  <a href="/" style="font-weight:700;font-family:'Poppins',sans-serif;">Dr. Suraga</a>
  <div>
    <a href="/#about">About</a>
    <a href="/#services">Services</a>
    <a href="/blog/">Blog</a>
    <a href="/#appointment">Book Now</a>
  </div>
</nav>
<div class="wrap">
{{ content | safe }}
</div>
<footer>© Dr. Suraga Belakawadi · <a href="https://www.instagram.com/onco_outreach" target="_blank">Instagram</a> · <a href="https://www.linkedin.com/in/suraga-b-4839b9282" target="_blank">LinkedIn</a></footer>
</body>
</html>
