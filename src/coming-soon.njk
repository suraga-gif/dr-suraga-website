---
# Temporary placeholder pages. Remove an entry from this list when its real page is built.
layout: layouts/base.njk
pagination:
  data: stubs
  size: 1
  alias: stub
stubs:
  - { url: /about/, title: About Dr. Suraga }
  - { url: /specialties/, title: Cancers treated }
  - { url: /specialties/upper-gi/, title: Upper GI cancers }
  - { url: /specialties/breast/, title: Breast cancer }
  - { url: /specialties/colorectal/, title: Colorectal cancers }
  - { url: /specialties/gynecological-hipec/, title: Gynaecological cancers and HIPEC }
  - { url: /specialties/pancreato-biliary/, title: Pancreas, gallbladder and bile duct cancers }
  - { url: /specialties/head-and-neck/, title: Head and neck cancers }
  - { url: /specialties/soft-tissue-sarcoma/, title: Soft tissue sarcomas }
  - { url: /robotic-surgery/, title: Robotic surgery }
  - { url: /blog/, title: Blog }
  - { url: /videos/, title: Videos }
  - { url: /publications/, title: Publications }
  - { url: /for-doctors/, title: For doctors }
  - { url: /appointment/, title: Book an appointment }
  - { url: /medical-disclaimer/, title: Medical disclaimer }
  - { url: /privacy-policy/, title: Privacy policy }
permalink: "{{ stub.url }}"
eleventyComputed:
  title: "{{ stub.title }}"
---
{% from "partials/icons.njk" import icon %}
<section class="section">
  <div class="container prose">
    <h1>{{ stub.title }}</h1>
    <p>This page is being written and will be ready soon.</p>
    <p>To book an appointment now, call <a href="{{ site.phone | telLink }}">{{ site.phoneDisplay }}</a> or send a message on WhatsApp. The clinic is open {{ site.hours }}.</p>
    <div class="button-row">
      <a class="btn btn-whatsapp" href="{{ site.whatsapp | whatsappLink(site.whatsappMessage) }}">{{ icon("whatsapp") }}WhatsApp</a>
      <a class="btn btn-secondary" href="/">Back to home page</a>
    </div>
  </div>
</section>
